{
  "mcpServers": {
    "webull": {
      "command": "uvx",
      "args": ["webull-openapi-mcp", "serve"],
      "env": {
        "WEBULL_APP_KEY": "${WEBULL_APP_KEY}",
        "WEBULL_APP_SECRET": "${WEBULL_APP_SECRET}",
        "WEBULL_REGION_ID": "us",
        "WEBULL_ENVIRONMENT": "prod",
        "WEBULL_API_CA_BUNDLE": "/etc/ssl/certs/ca-certificates.crt"
      }
    }
  }
}
